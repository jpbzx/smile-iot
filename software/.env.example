# Copy to .env and fill in — NEVER commit .env.
# Generate secrets with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# --- PostgreSQL (users / auth / audit) ---
POSTGRES_USER=smile
POSTGRES_PASSWORD=generate-me
POSTGRES_DB=smile_iot
DB_HOST=localhost          # backend runs on the host; containers resolve 'postgres'
DB_PORT=5432

# --- InfluxDB (energy time series) ---
INFLUX_USER=admin
INFLUX_PASSWORD=generate-me
INFLUX_ORG=smile_org
INFLUX_BUCKET=energy_data
INFLUX_ADMIN_TOKEN=generate-me
INFLUX_URL=http://localhost:8086
# Scoped read/write token for the backend. After first `docker compose up`:
#   docker exec smile_influx influx bucket list --org smile_org --name energy_data   # get <bucket-id>
#   docker exec smile_influx influx auth create --org smile_org \
#     --read-bucket <bucket-id> --write-bucket <bucket-id> --description "smile-backend"
INFLUX_TOKEN=paste-scoped-token-here

# --- MQTT (local Mosquitto from docker-compose) ---
# Set MQTT_HOST=broker.emqx.io to bridge to firmware that still points there.
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC_TELEMETRY=smile-iot/power
MQTT_TOPIC_COMMAND=smile-iot/command

# --- Flask API ---
JWT_SECRET_KEY=generate-me
SESSION_TIMEOUT_MIN=30
COST_PER_KWH=0.25

# --- Login security ---
MAX_FAILED_ATTEMPTS=5
LOCKOUT_MINUTES=15

# --- SMTP (password reset emails) — leave empty to disable sending ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
RESET_URL_BASE=http://localhost:5173/login
