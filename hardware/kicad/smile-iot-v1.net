(export (version "E")
  (design
    (source "SMILE-IoT PCB v1 — mains outlet monitor + relay switch")
    (date "2026-07-21")
    (tool "hand-authored from hardware/PCB_DESIGN_v1.md")
    (sheet (number "1") (name "/") (tstamps "/")
      (title_block
        (title "SMILE-IoT Outlet Node")
        (rev "v1")
        (comment (number "1") (value "230 VAC — HAZARDOUS mains zone. Review before fab."))
        (comment (number "2") (value "Pins named by function; reconcile with chosen symbol/footprint pads after import.")))))

  ;; ----------------------------------------------------------------------
  ;; Components (ref / value / footprint)
  ;; ----------------------------------------------------------------------
  (components
    (comp (ref "U1")
      (value "ESP32-DevKitC-V1")
      (footprint "Module:ESP32-DevKitC")
      (property (name "Zone") (value "SELV"))
      (property (name "Note") (value "30-pin DOIT DevKit V1; socket on 2x1x15 headers. See assignments doc.")))
    (comp (ref "PS1")
      (value "HLK-PM01")
      (footprint "Converter_ACDC:Converter_ACDC_HiLink_HLK-PMxx")
      (property (name "Zone") (value "BARRIER"))
      (property (name "Note") (value "Isolated 230VAC->5V 3W. Alt: HLK-10M05 (2A).")))
    (comp (ref "K1")
      (value "SRD-05VDC-SL-C")
      (footprint "Relay_THT:Relay_SPDT_SANYOU_SRD_Series_Form_C")
      (property (name "Zone") (value "BARRIER"))
      (property (name "Note") (value "SPDT 10A/250VAC, 5V coil. Coil<->contact >=3kV.")))
    (comp (ref "Q1")
      (value "BC547")
      (footprint "Package_TO_SOT_THT:TO-92_Inline")
      (property (name "Zone") (value "SELV")))
    (comp (ref "D1")
      (value "1N4007")
      (footprint "Diode_THT:D_DO-41_SOD81_P10.16mm_Horizontal")
      (property (name "Zone") (value "SELV"))
      (property (name "Note") (value "Coil flyback; K to +5V.")))
    (comp (ref "F1")
      (value "10A T 250V")
      (footprint "Fuse:Fuseholder_Cylinder-5x20mm_Schurter_0031_8201_Horizontal")
      (property (name "Zone") (value "MAINS")))
    (comp (ref "RV1")
      (value "S14K275")
      (footprint "Varistor:RV_Disc_D15mm_W5.1mm_P7.5mm")
      (property (name "Zone") (value "MAINS"))
      (property (name "Note") (value "MOV, L-N surge clamp.")))
    (comp (ref "R1")
      (value "1k")
      (footprint "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P10.16mm_Horizontal")
      (property (name "Zone") (value "SELV")))
    (comp (ref "R2")
      (value "330R")
      (footprint "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P10.16mm_Horizontal")
      (property (name "Zone") (value "SELV")))
    (comp (ref "R3")
      (value "10k")
      (footprint "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P10.16mm_Horizontal")
      (property (name "Zone") (value "SELV")))
    (comp (ref "R4")
      (value "10k")
      (footprint "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P10.16mm_Horizontal")
      (property (name "Zone") (value "SELV")))
    (comp (ref "R5")
      (value "100R")
      (footprint "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P10.16mm_Horizontal")
      (property (name "Zone") (value "SELV"))
      (property (name "Note") (value "Optional GPIO34 series protection; short if omitted.")))
    (comp (ref "C1")
      (value "470uF/10V")
      (footprint "Capacitor_THT:CP_Radial_D8.0mm_P3.50mm")
      (property (name "Zone") (value "SELV"))
      (property (name "Note") (value "5V bulk for WiFi TX bursts.")))
    (comp (ref "C2")
      (value "100nF")
      (footprint "Capacitor_THT:C_Disc_D5.0mm_W2.5mm_P5.00mm")
      (property (name "Zone") (value "SELV")))
    (comp (ref "C3")
      (value "10uF")
      (footprint "Capacitor_THT:CP_Radial_D5.0mm_P2.00mm")
      (property (name "Zone") (value "SELV"))
      (property (name "Note") (value "ADC bias decoupling.")))
    (comp (ref "LED1")
      (value "STATUS")
      (footprint "LED_THT:LED_D3.0mm")
      (property (name "Zone") (value "SELV")))
    (comp (ref "SW1")
      (value "BOOT/PROV")
      (footprint "Button_Switch_THT:SW_PUSH_6mm")
      (property (name "Zone") (value "SELV")))
    (comp (ref "J1")
      (value "MAINS_IN L/N/PE")
      (footprint "TerminalBlock:TerminalBlock_bornier-3_P5.08mm")
      (property (name "Zone") (value "MAINS")))
    (comp (ref "J2")
      (value "OUTLET_OUT L/N/PE")
      (footprint "TerminalBlock:TerminalBlock_bornier-3_P5.08mm")
      (property (name "Zone") (value "MAINS")))
    (comp (ref "J3")
      (value "SCT-013 JACK")
      (footprint "Connector_Audio:Jack_3.5mm_CUI_SJ1-353xN_Horizontal")
      (property (name "Zone") (value "SELV"))
      (property (name "Note") (value "PJ-320; tip=signal, sleeve=GND, ring unused.")))
    (comp (ref "H1")
      (value "VSENSE_RSVD")
      (footprint "Connector_PinHeader_2.54mm:PinHeader_1x03_P2.54mm_Vertical")
      (property (name "Zone") (value "SELV"))
      (property (name "Note") (value "DNP. Future ZMPT101B: GPIO35/3V3/GND."))))

  ;; ----------------------------------------------------------------------
  ;; Nets.  Pin identifiers are FUNCTION names (self-documenting) — after
  ;; import, confirm they match your symbol/footprint pad names, or use this
  ;; as the wiring spec when drawing the schematic in eeschema.
  ;; ----------------------------------------------------------------------
  (nets

    ;; ---- SELV power ----
    (net (code "1") (name "+5V")
      (node (ref "PS1") (pin "+Vo")  (pinfunction "+Vo")  (pintype "power_out"))
      (node (ref "C1")  (pin "+")    (pinfunction "+")    (pintype "passive"))
      (node (ref "C2")  (pin "1")    (pinfunction "1")    (pintype "passive"))
      (node (ref "U1")  (pin "VIN")  (pinfunction "VIN")  (pintype "power_in"))
      (node (ref "K1")  (pin "COILA")(pinfunction "COIL+")(pintype "passive"))
      (node (ref "D1")  (pin "K")    (pinfunction "K")    (pintype "passive")))

    (net (code "2") (name "GND")
      (node (ref "PS1")  (pin "-Vo") (pinfunction "-Vo") (pintype "power_out"))
      (node (ref "C1")   (pin "-")   (pinfunction "-")   (pintype "passive"))
      (node (ref "C2")   (pin "2")   (pinfunction "2")   (pintype "passive"))
      (node (ref "C3")   (pin "-")   (pinfunction "-")   (pintype "passive"))
      (node (ref "U1")   (pin "GND") (pinfunction "GND") (pintype "power_in"))
      (node (ref "Q1")   (pin "E")   (pinfunction "E")   (pintype "passive"))
      (node (ref "R4")   (pin "2")   (pinfunction "2")   (pintype "passive"))
      (node (ref "LED1") (pin "K")   (pinfunction "K")   (pintype "passive"))
      (node (ref "SW1")  (pin "2")   (pinfunction "2")   (pintype "passive"))
      (node (ref "J3")   (pin "S")   (pinfunction "Sleeve") (pintype "passive"))
      (node (ref "H1")   (pin "3")   (pinfunction "GND") (pintype "passive")))

    (net (code "3") (name "+3V3")
      (node (ref "U1") (pin "3V3") (pinfunction "3V3") (pintype "power_out"))
      (node (ref "R3") (pin "1")   (pinfunction "1")   (pintype "passive"))
      (node (ref "H1") (pin "2")   (pinfunction "3V3") (pintype "passive")))

    ;; ---- Current sense front-end ----
    (net (code "4") (name "SCT_BIAS")
      (node (ref "J3") (pin "T") (pinfunction "Tip") (pintype "passive"))
      (node (ref "R3") (pin "2") (pinfunction "2")   (pintype "passive"))
      (node (ref "R4") (pin "1") (pinfunction "1")   (pintype "passive"))
      (node (ref "C3") (pin "+") (pinfunction "+")   (pintype "passive"))
      (node (ref "R5") (pin "1") (pinfunction "1")   (pintype "passive")))

    (net (code "5") (name "GPIO34_ADC")
      (node (ref "R5") (pin "2")   (pinfunction "2")    (pintype "passive"))
      (node (ref "U1") (pin "D34") (pinfunction "GPIO34")(pintype "input")))

    ;; ---- Relay driver ----
    (net (code "6") (name "GPIO25_RLY")
      (node (ref "U1") (pin "D25") (pinfunction "GPIO25") (pintype "output"))
      (node (ref "R1") (pin "1")   (pinfunction "1")      (pintype "passive")))

    (net (code "7") (name "RLY_BASE")
      (node (ref "R1") (pin "2") (pinfunction "2") (pintype "passive"))
      (node (ref "Q1") (pin "B") (pinfunction "B") (pintype "input")))

    (net (code "8") (name "RLY_COIL_LO")
      (node (ref "Q1") (pin "C")    (pinfunction "C")     (pintype "passive"))
      (node (ref "K1") (pin "COILB")(pinfunction "COIL-") (pintype "passive"))
      (node (ref "D1") (pin "A")    (pinfunction "A")     (pintype "passive")))

    ;; ---- Status LED ----
    (net (code "9") (name "GPIO2_LED")
      (node (ref "U1") (pin "D2") (pinfunction "GPIO2") (pintype "output"))
      (node (ref "R2") (pin "1")  (pinfunction "1")     (pintype "passive")))

    (net (code "10") (name "LED_ANODE")
      (node (ref "R2")   (pin "2") (pinfunction "2") (pintype "passive"))
      (node (ref "LED1") (pin "A") (pinfunction "A") (pintype "passive")))

    ;; ---- Provisioning button ----
    (net (code "11") (name "GPIO0_BTN")
      (node (ref "U1")  (pin "D0") (pinfunction "GPIO0") (pintype "input"))
      (node (ref "SW1") (pin "1")  (pinfunction "1")     (pintype "passive")))

    ;; ---- Reserved voltage-sense header (DNP) ----
    (net (code "12") (name "VSENSE_RSVD")
      (node (ref "U1") (pin "D35") (pinfunction "GPIO35") (pintype "input"))
      (node (ref "H1") (pin "1")   (pinfunction "GPIO35") (pintype "passive")))

    ;; ======================================================================
    ;; MAINS ZONE (230 VAC) — keep left of the isolation slot
    ;; ======================================================================
    (net (code "13") (name "L_IN")
      (node (ref "J1") (pin "1") (pinfunction "LIVE")  (pintype "passive"))
      (node (ref "F1") (pin "1") (pinfunction "1")     (pintype "passive")))

    (net (code "14") (name "L_FUSED")
      (node (ref "F1")  (pin "2")   (pinfunction "2")   (pintype "passive"))
      (node (ref "RV1") (pin "1")   (pinfunction "1")   (pintype "passive"))
      (node (ref "PS1") (pin "ACL") (pinfunction "AC")  (pintype "power_in"))
      (node (ref "K1")  (pin "COM") (pinfunction "COM") (pintype "passive")))

    (net (code "15") (name "N")
      (node (ref "J1")  (pin "2")   (pinfunction "NEUTRAL") (pintype "passive"))
      (node (ref "RV1") (pin "2")   (pinfunction "2")       (pintype "passive"))
      (node (ref "PS1") (pin "ACN") (pinfunction "AC")      (pintype "power_in"))
      (node (ref "J2")  (pin "2")   (pinfunction "NEUTRAL") (pintype "passive")))

    (net (code "16") (name "PE")
      (node (ref "J1") (pin "3") (pinfunction "EARTH") (pintype "passive"))
      (node (ref "J2") (pin "3") (pinfunction "EARTH") (pintype "passive")))

    (net (code "17") (name "L_SWITCHED")
      (node (ref "K1") (pin "NO") (pinfunction "NO")   (pintype "passive"))
      (node (ref "J2") (pin "1")  (pinfunction "LIVE") (pintype "passive")))))
